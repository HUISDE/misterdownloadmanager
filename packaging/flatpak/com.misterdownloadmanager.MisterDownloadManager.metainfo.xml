     CHANGELOG.md has its <release> here, newest first (a test in crates/ipc/src/flatpak.rs). -->
<component type="desktop-application">
  <id>com.misterdownloadmanager.MisterDownloadManager</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Mister Download Manager</name>
  <summary>Download faster, resume, and catch downloads from the browser</summary>
  <developer id="com.misterdownloadmanager">
    <name>Ahmed Nefzaoui</name>
  </developer>
  <description>
    <p>
      Mister Download Manager speeds up downloads by fetching each file over several connections
      at once, resumes them after a dropped connection or a restart, and takes over the downloads
      you click in your browser. It is free and open source, with no ads, no trial and no sign-up.
    </p>
    <ul>
      <li>Several connections per file, with servers' limits learned as it goes</li>
      <li>Resume broken downloads, even days later</li>
      <li>Browser integration for Firefox, Chrome, Edge, Brave, Opera and Vivaldi</li>
      <li>Videos from web pages, image galleries, torrents and magnet links</li>
      <li>Queues, a scheduler and a speed limiter</li>
      <li>Categories that sort files into their own folders</li>
      <li>86 languages, with right-to-left windows for Arabic, Hebrew and Persian</li>
    </ul>
    <p>
      Browsers installed as a Flatpak or a Snap can't start the helper this sandboxed copy gives
      browsers, so browser integration works with browsers installed from your distribution's
      packages or their makers' own.
    </p>
  </description>
